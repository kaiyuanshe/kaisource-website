NEXT_PUBLIC_API_URL=/v1
# Set true only for the disposable read-only showcase.
SITE_PREVIEW_MODE=false
# Shared production Go API origin used by the Vercel same-origin /v1 proxy.
# Keep the Azure API as the authoritative data source until the backend is
# migrated to a managed Vercel-compatible runtime.
API_PROXY_ORIGIN=https://kaiyuanshe.cn
# Used by server-side NextAuth credential providers. Defaults to
# ${API_PROXY_ORIGIN}/v1 when omitted.
INTERNAL_API_URL=https://kaiyuanshe.cn/v1
NEXT_PUBLIC_APP_NAME=开源社
NEXT_PUBLIC_APP_NAME_EN=KaiSource
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_API_KEY=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_FOLDERS=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_STATIC_ASSETS=false
CLOUDINARY_STATIC_FOLDER=kyswebsite/static

# Auth
NEXTAUTH_URL=
NEXTAUTH_SECRET=

NEXT_PUBLIC_OAUTH=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
