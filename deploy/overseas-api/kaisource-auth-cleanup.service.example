[Unit]
Description=Prune expired KaiSource authentication state (not statistics)
After=postgresql.service

[Service]
Type=oneshot
User=azureuser
Group=azureuser
WorkingDirectory=/home/azureuser/kaisource-api/current
ExecStart=/home/azureuser/kaisource-api/current/server -mode cleanup
Environment=KAISOURCE_CONFIG_FILE=/home/azureuser/website/kaiyuanshe/config.yaml
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
TimeoutStartSec=40
UMask=0077
