# Include ONLY inside the existing HTTPS server block for kaiyuanshe.cn.
# These additive locations never replace /v1, /api, / or domestic frontend.
location ^~ /kaisource-api/v1/ {
    proxy_pass http://127.0.0.1:8081/v1/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header Connection "";
    proxy_buffering off;
    proxy_read_timeout 65s;
    client_max_body_size 10m;
    add_header Cache-Control "no-store" always;
}
location = /kaisource-api/healthz {
    proxy_pass http://127.0.0.1:8081/healthz;
    add_header Cache-Control "no-store" always;
}
